# Copy values into apps/api/.env and apps/web/.env.local as needed

# --- API (apps/api/.env) ---
APP_NAME="Upwork BD"
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=upwork_bd
DB_USERNAME=upwork
DB_PASSWORD=secret

REDIS_HOST=127.0.0.1
REDIS_PORT=6380
QUEUE_CONNECTION=redis
CACHE_STORE=redis
BROADCAST_CONNECTION=reverb
REDIS_CLIENT=predis

# Master switch — leave false until Upwork MCP Support clears scheduled polling
UPWORK_POLLING_ENABLED=false
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
# Must be a localhost callback — Upwork MCP DCR rejects public https redirects
UPWORK_OAUTH_REDIRECT_URI=http://localhost:8000/upwork/oauth/callback

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

SLACK_WEBHOOK_URL=

REVERB_APP_ID=upwork-bd
REVERB_APP_KEY=upwork-bd-key
REVERB_APP_SECRET=upwork-bd-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# --- Web (apps/web/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_REVERB_KEY=upwork-bd-key
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
